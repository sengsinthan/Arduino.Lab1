<Window x:Class="Lab1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Lab1.ViewModels"
        mc:Ignorable="d"
        Title="Arduino Button Demo" Height="450" Width="800">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top row: port picker + buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="200" Margin="0,0,12,0"
                      ItemsSource="{Binding Ports}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="PortName"
                      SelectedValue="{Binding SelectedPort}"/>
            <Button Content="Refresh" Width="80" Margin="0,0,12,0"
                    Command="{Binding RefreshCommand}"/>
            <Button Content="{Binding ConnectButtonText}" Width="90" Margin="0,0,12,0"
                    Command="{Binding ConnectCommand}"/>
            <Button Content="Ping Arduino" Width="110" Margin="0,0,12,0"
                    Command="{Binding PingCommand}"/>
            <Button Content="LED On" Width="80" Margin="0,0,12,0"
                    Command="{Binding LedOnCommand}"/>
            <Button Content="LED Off" Width="80"
                    Command="{Binding LedOffCommand}"/>
        </StackPanel>

        <!-- Log of everything sent/received -->
        <TextBox Grid.Row="1" Margin="0,12,0,0"
                 Text="{Binding Log, Mode=OneWay}"
                 IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" TextWrapping="Wrap"/>
    </Grid>
</Window>
